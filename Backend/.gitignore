# ===================================
#   BACKEND .gitignore
#   Node.js + Express + MySQL
# ===================================

# ── Dependencies ──────────────────
node_modules/
.npm/

# ── Environment Variables ─────────
.env
.env.*
!.env.example

# ── Logs ──────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Build / Compiled Output ───────
dist/
build/
out/

# ── Database / Dumps ──────────────
*.sql
*.sqlite
*.sqlite3
*.db
dump/
backups/

# ── Uploads / Media ───────────────
uploads/
public/uploads/
media/

# ── SSL / Certs / Keys ────────────
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx

# ── OS Generated ──────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Editor / IDE ──────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?
*.swp
*.swo

# ── Runtime / Temp ────────────────
*.local
*.tmp
*.temp
.cache/
tmp/
temp/
pids/
*.pid
*.seed
*.pid.lock

# ── Package Manager ───────────────
# ── Coverage / Testing ────────────
coverage/
.nyc_output/
*.test.js.snap
