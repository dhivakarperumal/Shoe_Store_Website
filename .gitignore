# ===================================
#   ROOT - OVERALL .gitignore
#   Shoe Store Website (Monorepo)
# ===================================

# ── Dependencies ──────────────────
node_modules/
.npm/

# ── Environment Variables ─────────
.env
.env.*
!.env.example

# ── Build Outputs ─────────────────
dist/
dist-ssr/
build/
out/

# ── Logs ──────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── OS Generated ──────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Editor / IDE ──────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# ── Runtime / Temp ────────────────
*.local
*.tmp
*.temp
.cache/
tmp/
temp/

# ── Package Manager ───────────────
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
